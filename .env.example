# Backend (Flask)
DB_URL=postgresql://user:password@host:5432/dbname  # CAMBIAR_ESTE_VALOR (ej. mssql+pyodbc://...)
JWT_SECRET_KEY=CAMBIAR_ESTE_VALOR
TECH_INITIAL_PASSWORD=CAMBIAR_ESTE_VALOR
SERVER_PORT=5000

# Uploads / evidencias
UPLOAD_DIR=/app/uploads
EVIDENCE_UPLOAD_DIR=/app/uploads/evidences
EVIDENCE_MAX_FILE_SIZE=10485760
EVIDENCE_ALLOWED_MIME_TYPES=image/png,image/jpeg,application/pdf

# Notificaciones
ENABLE_NOTIFICATION_WORKER=false
NOTIFICATION_WORKER_INTERVAL=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Base de datos (solo desarrollo local con compose)
DB_USERNAME=CAMBIAR_ESTE_VALOR
DB_PASSWORD=CAMBIAR_ESTE_VALOR
MSSQL_SA_PASSWORD=CAMBIAR_ESTE_VALOR

# Desktop
SIGOS_API_BASE_URL=http://localhost:5000

# Mobile (passed with --dart-define)
# SIGOS_API_BASE_URL=http://10.0.2.2:5000