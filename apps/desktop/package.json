{
    "name": "sigos-desktop",
    "version": "0.1.0",
    "description": "SIGOS 2.0 desktop client",
    "main": "src/main/index.js",
    "scripts": {
        "start": "electron .",
        "test": "node --test tests/**/*.test.js",
        "dist": "electron-builder --win"
    },
    "devDependencies": {
        "electron": "^33.4.11",
        "electron-builder": "^25.0.0"
    },
    "build": {
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*"
        ],
        "productName": "SIGOS Desktop",
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico"
        },
        "appId": "com.sigos.desktop",
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "dependencies": {
        "chart.js": "^4.4.1"
    }
}
