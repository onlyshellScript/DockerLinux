# Variables del compose de producción (Linux). Copiar a infra/docker/.env y rellenar.
# NO commitear el .env real.

# --- SQL Server ---
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# Evita @ : / ? # % en la contraseña: va dentro de DB_URL sin codificar.
MSSQL_SA_PASSWORD=CAMBIAR_ESTE_VALOR
MSSQL_PID=Express
# Fija una versión concreta en producción, p. ej. 2022-CU16-ubuntu-22.04
MSSQL_IMAGE_TAG=2022-latest
DB_NAME=sigos

# --- API ---
JWT_SECRET_KEY=CAMBIAR_ESTE_VALOR   # python -c "import secrets; print(secrets.token_urlsafe(64))"
SIGOS_VERSION=latest
API_BIND=127.0.0.1                  # 0.0.0.0 para exponer sin proxy inverso
API_PORT=5000
GUNICORN_WORKERS=4
TZ=America/Bogota

# --- Notificaciones (worker) ---
NOTIFICATION_WORKER_INTERVAL=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
