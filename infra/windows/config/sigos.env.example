# SIGOS - servicios Windows. Referencia de C:\ProgramData\SIGOS\config\sigos.env.
# install-windows.ps1 genera el archivo real con secretos aleatorios y ACL restringida
# (Administradores y SYSTEM: control total; NT SERVICE\SIGOS-API y NT SERVICE\SIGOS-Worker: lectura).
# Una reinstalacion o actualizacion NO lo sobrescribe: solo añade claves que falten.
# Tras editarlo: .\restart-services.ps1

SIGOS_ENV=production
JWT_SECRET_KEY=GENERADO_POR_EL_INSTALADOR

# --- Base de datos: SQL Server (produccion) ---
# La URL se construye en codigo (usuario y contraseña codificados); no hace falta DB_URL.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=sigos
DB_APP_USER=sigos_app
DB_APP_PASSWORD=GENERADO_POR_EL_INSTALADOR
# Opcionales: DB_DRIVER=ODBC Driver 18 for SQL Server, DB_TRUST_SERVER_CERTIFICATE=yes

# --- Base de datos: SQLite (demostracion; sustituye al bloque anterior) ---
# DB_URL=sqlite:///C:/ProgramData/SIGOS/data/sigos.db

# --- Rutas ---
UPLOAD_DIR=C:\ProgramData\SIGOS\data\uploads
EVIDENCE_UPLOAD_DIR=C:\ProgramData\SIGOS\data\uploads\evidences

# --- Logs (stdout/stderr -> C:\ProgramData\SIGOS\logs, rotados por WinSW) ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sin proxy inverso delante: no confiar en cabeceras X-Forwarded-*. Con IIS/Caddy delante: 1.
PROXY_FIX_HOPS=0

# --- Notificaciones (SIGOS-Worker) ---
NOTIFICATION_WORKER_INTERVAL=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Las credenciales del usuario migrador (DB_MIGRATOR_USER / DB_MIGRATOR_PASSWORD) van en
# admin.env, legible solo por Administradores: los servicios nunca tienen permisos DDL.
