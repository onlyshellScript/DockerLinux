# Variables del compose de producción (Linux). Copiar a infra/docker/.env y rellenar.
# NO commitear el .env real.

# --- SQL Server ---
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# Las contraseñas pueden contener @ : / ? # %: la app arma las URLs codificándolas.
# Evita solo comillas dobles y $ (el compose interpola $). Alternativa: variables *_FILE
# (DB_APP_PASSWORD_FILE, JWT_SECRET_KEY_FILE, ...) apuntando a docker secrets.
# La contraseña de sa solo la reciben los servicios sqlserver y migrate.
MSSQL_SA_PASSWORD=CAMBIAR_ESTE_VALOR
MSSQL_PID=Express
# Versión fija (verificada en mcr.microsoft.com). Actualizar de forma controlada.
MSSQL_IMAGE_TAG=2022-CU16-ubuntu-22.04
DB_NAME=sigos

# Usuario migrador: SOLO lo usa el servicio migrate para Alembic.
# Roles: db_ddladmin, db_datareader, db_datawriter.
DB_MIGRATOR_USER=sigos_migrator
DB_MIGRATOR_PASSWORD=CAMBIAR_ESTE_VALOR

# Usuario de aplicación (runtime de api y worker). Roles: db_datareader, db_datawriter y EXECUTE.
# Si venía de despliegues previos con db_ddladmin, migrate se lo retira. Ninguno de los dos logins
# puede ser sysadmin (migrate aborta).
DB_APP_USER=sigos_app
DB_APP_PASSWORD=CAMBIAR_ESTE_VALOR

# Memoria (SQL Server en Linux exige >= 2048 MB; MSSQL_MEMORY_LIMIT_MB < SQLSERVER_MEM_LIMIT).
SQLSERVER_MEM_LIMIT=3g
MSSQL_MEMORY_LIMIT_MB=2048
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=512m

# --- API ---
JWT_SECRET_KEY=CAMBIAR_ESTE_VALOR   # python -c "import secrets; print(secrets.token_urlsafe(64))"
SIGOS_VERSION=latest
# La API no publica puertos. Acceso directo de diagnóstico: añadir docker-compose.debug.yaml
# (usa API_BIND/API_PORT, por defecto 127.0.0.1:5000).
GUNICORN_WORKERS=4
TZ=America/Bogota

# --- Proxy (Caddy) ---
# Vacío = HTTP plano en :80, SIN TLS ni HSTS: solo aceptable detrás de un balanceador que
# termine TLS. Con dominio = HTTPS automático + HSTS (DNS apuntando al host, 80/443 abiertos).
SIGOS_DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443
# Tamaño máximo de petición (evidencias: 10 MB por archivo + margen multipart).
PROXY_MAX_BODY=25MB

# --- Notificaciones (worker) ---
NOTIFICATION_WORKER_INTERVAL=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
