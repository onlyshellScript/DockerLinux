{
    "name": "sigos-desktop",
    "version": "0.1.0",
    "description": "SIGOS 2.0 desktop client",
    "main": "src/main/index.js",
    "scripts": {
        "start": "electron .",
        "test": "node --test \"tests/**/*.test.js\"",
        "dist": "electron-builder --win",
        "dist:linux": "electron-builder --linux AppImage"
    },
    "devDependencies": {
        "electron": "^33.4.11",
        "electron-builder": "^25.0.0",
        "jsdom": "31.0.0",
        "playwright": "^1.65.0"
    },
    "build": {
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "assets/**/*"
        ],
        "productName": "SIGOS Desktop",
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico"
        },
        "appId": "com.sigos.desktop",
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "icon": "assets/icon.png",
            "category": "Office",
            "executableName": "sigos-desktop",
            "artifactName": "SIGOS-Desktop-${arch}.${ext}",
            "synopsis": "Cliente de escritorio de SIGOS",
            "desktop": {
                "entry": {
                    "Name": "SIGOS",
                    "Comment": "Gestión de órdenes de servicio",
                    "StartupWMClass": "SIGOS Desktop"
                }
            }
        }
    },
    "dependencies": {
        "chart.js": "^4.4.1"
    },
    "author": {
        "name": "SIGOS"
    },
    "homepage": "https://github.com/onlyshellScript/DockerLinux"
}
